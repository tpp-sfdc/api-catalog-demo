# Copy to .env and fill in your Connected App credentials.
#   cp .env.example .env
#
# .env is git-ignored so secrets never get committed.
# The Anypoint API Catalog CLI reads these variable names automatically.

# Organization (required).
# Docs describe this as the organization ID (a UUID from Access Management);
# the CLI --help labels it "Organization Name". Use the ID first; if auth
# fails, try the business-group name.
ANYPOINT_ORG="00000000-0000-0000-0000-000000000000"

# Connected App credentials (required).
# The app needs the "API Catalog Contributor" + "View Environment" scopes.
ANYPOINT_CLIENT_ID="your-connected-app-client-id"
ANYPOINT_CLIENT_SECRET="your-connected-app-client-secret"

# Optional — target environment name (defaults to your org's default env).
# ANYPOINT_ENV="Sandbox"

# Optional — defaults to anypoint.mulesoft.com (US control plane).
# Use eu1.anypoint.mulesoft.com for the EU control plane.
# ANYPOINT_HOST="anypoint.mulesoft.com"
